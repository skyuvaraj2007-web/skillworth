# SkillWorth — Recognition of Prior Learning Platform
# Environment Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=production

# Security & Authentication
JWT_SECRET=your_skillworth_secure_jwt_secret_key_here

# Supabase Database Configuration (Backend / Server-Side)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Frontend Supabase Configuration (Browser-Safe Client)
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Optional: External AI Provider Keys (SkillWorth includes robust built-in NLP heuristics by default)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_MODEL=gpt-4o-mini
